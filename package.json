{
  "name": "x-repository-template",
  "version": "1.0.0",
  "description": "x-repository-template は pnpm を用いたモノレポ向けのテンプレートリポジトリです。主にフロントエンドの Web Framework (Vite, Next.js) の template と共通パッケージを同一ワークスペースで管理するためのベース構成を提供します。新規プロジェクトの立ち上げや内部テンプレートとして利用することを想定しています。",
  "keywords": [],
  "author": "Masayuki Iizuka <mas.iizuka@gmail.com>",
  "scripts": {
    "app": "pnpm app:nextjs",
    "app:nextjs": "pnpm -F app-nextjs",
    "app:vite": "pnpm -F app-vite",
    "x": "pnpm -F @112ka/x",
    "x3": "pnpm -F @112ka/x3",
    "x-lib": "pnpm -F x-lib",
    "lint": "vp lint . && pnpm -r lint",
    "lint:fix": "vp lint --fix . && pnpm -r lint:fix",
    "watch:x": "pnpm x watch",
    "watch:x3": "pnpm x3 watch",
    "watch": "pnpm -r -F @112ka/x -F @112ka/x3 watch",
    "dev": "pnpm dev:nextjs",
    "dev:nextjs": "concurrently \"pnpm watch\" \"pnpm app:nextjs dev\"",
    "dev:vite": "concurrently \"pnpm watch\" \"pnpm app:vite dev\"",
    "build:x": "pnpm x build",
    "build:x3": "pnpm x3 build",
    "build": "pnpm -r -F @112ka/x -F @112ka/x3 build",
    "testAll": "pnpm -r test",
    "prepare": "simple-git-hooks",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "@tsconfig/recommended": "1.0.13",
    "@types/node": "26.6.6",
    "concurrently": "10.0.6",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "packages/x/**/*.{js,ts,jsx,tsx}": "pnpm x lint:fix --",
    "packages/x-lib/**/*.{js,ts,jsx,tsx}": "pnpm x-lib lint:fix --",
    "packages/x3/**/*.{js,ts,jsx,tsx}": "pnpm x3 lint:fix --",
    "apps/app-nextjs/**/*.{js,ts,jsx,tsx}": "pnpm app:nextjs lint:fix --",
    "apps/app-vite/**/*.{js,ts,jsx,tsx}": "pnpm app:vite lint:fix --"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.6"
    }
  },
  "engines": {
    "node": ">=26.6",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
