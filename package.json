{
  "name": "@112ka/x",
  "version": "0.0.11",
  "description": "軽量でモジュール化された TypeScript ユーティリティライブラリ。複数の小さなモジュール群を ES モジュールとして提供し、必要な機能を選択的にインポート可能な設計。",
  "keywords": [],
  "author": "Masayuki Iizuka <mas.iizuka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/112KA/x.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/**/*.d.mts",
      "default": "./dist/**/*.mjs"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "build": "vp pack",
    "watch": "vp pack --watch",
    "test": "vp test --run --coverage"
  },
  "devDependencies": {
    "@tsconfig/recommended": "1.0.13",
    "@types/webxr": "^0.5.22",
    "@types/youtube": "^0.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  }
}
