{
  "name": "@112ka/x",
  "version": "0.0.12",
  "description": "軽量でモジュール化された TypeScript ユーティリティライブラリ。複数の小さなモジュール群を ES モジュールとして提供し、必要な機能を選択的にインポート可能な設計。",
  "keywords": [],
  "author": "Masayuki Iizuka <mas.iizuka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/112KA/x.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "build": "vp pack",
    "watch": "vp pack --watch",
    "test": "vp test --run --coverage"
  },
  "devDependencies": {
    "@types/webxr": "0.5.24",
    "@types/youtube": "0.3.0",
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
