{
  "name": "@112ka/x3",
  "type": "module",
  "version": "0.0.4",
  "description": "Three.js ベースの 3D グラフィックレンダリングライブラリ。WebGL/WebGPU レンダラーの抽象化、シーン・カメラ・ビューポート管理、アセット管理、プラグイン拡張機構を提供。",
  "keywords": [],
  "author": "Masayuki Iizuka <mas.iizuka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/112KA/x-monorepo.git",
    "directory": "packages/x3"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "build": "vp pack",
    "watch": "vp pack --watch"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/three": "0.182.0",
    "stats-gl": "3.8.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "@112ka/x": "0.0.12",
    "stats-gl": "3.8.0",
    "three": "0.182.0"
  }
}
