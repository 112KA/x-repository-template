{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "ignorePaths": [],
  "packageRules": [
    {
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies",
      "automerge": true,
      "platformAutomerge": true,
      "matchPackageNames": ["*"]
    }
  ]
}
